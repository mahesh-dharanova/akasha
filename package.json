{
  "name": "akasha",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:astronomy": "node tests/astronomy-check.mjs",
    "test:visibility": "node --experimental-strip-types tests/visibility-check.mjs",
    "test:catalogue": "node --experimental-strip-types tests/catalogue-check.mjs",
    "test:windows": "node tests/observing-window-check.cjs",
    "test:planner": "node tests/planner-check.cjs",
    "test:youtube": "node tests/youtube-check.cjs",
    "test:relationships": "node tests/relationships-check.mjs",
    "test:observer": "node --experimental-strip-types tests/observer-context-check.mjs",
    "test:dashboard": "node --experimental-strip-types tests/dashboard-check.mjs",
    "test:aerial": "node --experimental-strip-types tests/aerial-check.mjs",
    "test:reproducibility": "node --experimental-strip-types tests/reproducibility-check.mjs",
    "verify": "npm run check && npm run test:astronomy && npm run test:visibility && npm run test:catalogue && npm run test:windows && npm run test:planner && npm run test:youtube && npm run test:relationships && npm run test:observer && npm run test:dashboard && npm run test:aerial && npm run test:reproducibility && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
